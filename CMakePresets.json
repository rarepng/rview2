{
  "version": 4,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "description": "minimum",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/dist/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "gcc",
      "inherits": "base",
      "displayName": "GCC",
      "cacheVariables": { "CMAKE_C_COMPILER": "gcc", "CMAKE_CXX_COMPILER": "g++" }
    },
    {
      "name": "clang",
      "inherits": "base",
      "displayName": "Clang",
      "description": "GCC ABI and libraries are critical",
      "cacheVariables": { "CMAKE_C_COMPILER": "clang", "CMAKE_CXX_COMPILER": "clang++" }
    },
    {
    "name": "droid",
    "inherits": "clang",
    "displayName": "Android ARM64",
    "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Android",
        "CMAKE_SYSTEM_VERSION": "34",
        "ANDROID_ABI": "arm64-v8a",
        "CMAKE_ANDROID_ARCH_ABI": "arm64-v8a",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/droidproxy.cmake",
        "ANDROID_PLATFORM": "android-34",
        "ANDROID_STL":"c++_static",
        "RVIEW_HEADLESS":"0",
        "CMAKE_ANDROID_NDK": "$env{ANDROID_NDK_HOME}",
        "CUSTOM_LLVM_DIR": "$env{customLlvmBin}",
        "CMAKE_C_COMPILER":"$env{customLlvmBin}/clang.exe",
        "CMAKE_CXX_COMPILER":"$env{customLlvmBin}/clang++.exe"
      }
    }
  ],
  "buildPresets": [
    { "name": "mermaid", "configurePreset": "gcc", "configuration": "mermaid" },
    { "name": "realclang", "configurePreset": "clang", "configuration": "Debug" },
    { "name": "realclangREL", "configurePreset": "clang", "configuration": "Release" },
    { "name": "realclangRELDBGINFO", "configurePreset": "clang", "configuration": "RelWithDebInfo" },
    { "name": "realclangDIST", "configurePreset": "clang", "configuration": "Distribution" },
    { "name": "realclang512", "configurePreset": "clang", "configuration": "BleedingEdge" },
    { "name": "realclangsanitize", "configurePreset": "clang", "configuration": "sanitize" },
    { "name": "droid64", "configurePreset": "droid", "configuration": "Debug" }
  ]
}
